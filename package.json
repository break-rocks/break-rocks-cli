{
  "name": "breakrocks",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "The command-line client of break.rocks: agent operators, delegated agents, x402 payments, offline theme tools and an MCP server, for a terminal or an AI agent.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "breakrocks": "./bin/breakrocks.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
