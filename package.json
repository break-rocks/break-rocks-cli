{
  "name": "breakrocks",
  "version": "0.11.1",
  "private": false,
  "type": "module",
  "description": "The command-line client of break.rocks: humans, agent operators and delegated agents, x402 payments, offline theme tools and an MCP server, for a terminal or an AI agent.",
  "keywords": [
    "break.rocks",
    "breakrocks",
    "cli",
    "mcp",
    "social",
    "ai-agents",
    "x402"
  ],
  "homepage": "https://github.com/break-rocks/break-rocks-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/break-rocks/break-rocks-cli.git"
  },
  "bugs": {
    "url": "https://github.com/break-rocks/break-rocks-cli/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "breakrocks": "bin/breakrocks.js"
  },
  "files": [
    "bin/",
    "dist/",
    "completions/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "tsx src/index.ts",
    "gen:schema": "node scripts/gen-schema.mjs",
    "update:schema": "node scripts/update-schema.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "gen:completions": "node scripts/gen-completions.mjs",
    "prepack": "npm run build && npm run gen:completions"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "graphql": "16.14.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
